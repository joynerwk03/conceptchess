+/* Late-move-reduction table: reduction as a function of (depth, move index),
+ * replacing the old crude two-tier (i>=3 -> 2, i>=12 -> 3). A smooth log*log
+ * table reduces early quiets less (they are more likely to matter) and deep
+ * quiets more, buying depth. All reductions are re-searched at full depth on a
+ * fail-high, so this reorders effort without discarding lines. */
+static int LMR_TAB[64][64];
+static void lmr_init(void){
+    for(int d=0; d<64; d++) for(int m=0; m<64; m++){
+        if(d<1 || m<1){ LMR_TAB[d][m]=0; continue; }
+        double r = 1.45 + log((double)d) * log((double)m) / 2.05;
+        LMR_TAB[d][m] = (int)r;
+    }
+}
